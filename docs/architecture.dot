// LineGuard architecture (final system). Render: dot -Tpng docs/architecture.dot -o docs/architecture.png
digraph LineGuard {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=13, labelloc=t, pad=0.3, nodesep=0.3, ranksep=0.5,
         label="LineGuard system architecture (final system, 7 Nov)\nevery box is built; file names are the modules in src/\n "];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#dbeafe", color="#1e3a8a"];
  edge  [fontname="Helvetica", fontsize=9, color="#334155"];

  subgraph cluster_online {
    label="Online: inspection of each part (run_line.py)"; fontsize=11; style="rounded"; color="#94a3b8";
    source  [label="1. Acquisition\nvideo file / webcam / folder\nacquisition.py"];
    trigger [label="2. Station trigger\ndark blob fully inside the ROI,\npart-centred crop, N frame votes\nacquisition.py"];
    pre     [label="3. Pre-processing\nresize, scale / normalise\ndata.py, foundad.py"];
    ai      [label="4. AI defect detection\nFoundAD: DINOv2 + predictor (primary)\nAE: rebuild error | CNN: P(defect)\ninference.py", fillcolor="#fde68a", color="#92400e", penwidth=2];
    decide  [label="5. Decision engine\nPASS < t_low <= REVIEW < t_high <= REJECT\nseverity minor / moderate / severe\ndecision.py"];
    explain [label="6. Explanation\npatch-error map / AE error map / Grad-CAM\nvisualize.py"];
    reject  [label="7. Reject signal\nevent log + beep (PLC in production)\nreject.py"];
    qclog   [label="8. QC log\nSQLite + CSV export\nqclog.py", shape=cylinder, fillcolor="#e2e8f0"];
    dash    [label="9. Operator dashboard\nlive view, KPIs, control chart,\nreview queue, settings\ndashboard.py (Streamlit)"];
    alerts  [label="10. Alerts\np-chart reject-rate spike, camera stall\nalerts.py"];
    feed    [label="Annotated feed\n<source>_annotated.mp4 / live window"];
  }

  subgraph cluster_offline {
    label="Offline: building the models"; fontsize=11; style="rounded"; color="#94a3b8";
    data    [label="MVTec AD bottle\n+ fixed split A / B\ndata.py, download_data.py", shape=cylinder, fillcolor="#e2e8f0"];
    dino    [label="DINOv2 ViT-S/14 weights\ndownload_backbone.py (hash-checked)", shape=cylinder, fillcolor="#e2e8f0"];
    train   [label="11. Training + calibration\ntrain_foundad.py (4 good images, CutPaste)\ntrain_ae.py / train_cnn.py"];
    evalb   [label="12. Evaluation on split B\nevaluate.py -> results/"];
    weights [label="weights/*.pt\nmodel + thresholds", shape=cylinder, fillcolor="#e2e8f0"];
    video   [label="Demo camera feed\nmake_line_video.py: real split-B photos\non a simulated belt", shape=note, fillcolor="#e2e8f0"];
  }

  source -> trigger -> pre -> ai -> decide;
  ai -> explain;
  decide -> reject;
  decide -> qclog;
  explain -> qclog [label="heatmap file"];
  qclog -> dash;
  qclog -> alerts;
  alerts -> qclog [label="alert rows", constraint=false];
  dash -> qclog [label="operator settings\n(thresholds, bands, limits)\nand confirmed labels", constraint=false, color="#1d4ed8"];
  qclog -> decide [label="settings read\nbefore each part", constraint=false, color="#1d4ed8"];
  decide -> feed;
  explain -> feed;

  data -> train -> weights;
  dino -> train;
  dino -> ai [label="frozen encoder"];
  weights -> evalb;
  data -> evalb;
  weights -> ai [label="loaded at start"];
  data -> video [label="20 held-out images"];
  video -> source [style=dashed];
}
